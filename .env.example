# Strava API credentials (set once by the app owner; every visitor then connects
# their OWN Strava account through the website).
# Create an app at https://www.strava.com/settings/api to get these, and set the
# app's "Authorization Callback Domain" to the domain you serve from
# (e.g. localhost for local testing, or your-subdomain.trycloudflare.com).
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Optional: fixed secret for signing session cookies. If unset, a random one is
# generated and stored in .secret_key so logins survive restarts.
SPRINTGPT_SECRET=

# Where the SQLite database lives.
SPRINTGPT_DB=sprintgpt.db

# Email (SMTP) for password-reset links. If left blank, password reset still works
# but shows the reset link on screen instead of emailing it.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SprintGPT <you@example.com>
SMTP_USE_TLS=true

# Public base URL used to build links in emails (e.g. https://sprintgpt.example.com).
# If unset, links are built from the incoming request.
APP_BASE_URL=

# Admin analytics dashboard access. Comma-separated emails that can view /admin.
# If left blank, the first account you register is treated as the owner/admin.
ADMIN_EMAILS=
